# Server configuration. Copy to .env and fill in the provider you use.
#
# This file is for the SERVER only — the client never needs an API key.
# server/src/resumix_server/resources/models.toml has one [provider] table
# naming the key/endpoint variables below, shared by the five models
# (detect, summary, cv, review, highlight) — fill in the one provider you use.

# --- LLM provider -------------------------------------------------------
# One provider, one key/endpoint pair — any OpenAI-compatible /chat/completions
# API works. Shipped pointing at Alibaba DashScope (Qwen); to switch, just
# replace the two values below, e.g.:
#   OpenAI:    https://api.openai.com/v1
#   DeepSeek:  https://api.deepseek.com/v1
#   Ollama:    http://localhost:11434/v1  (MODEL_API_KEY can be any string —
#              Ollama ignores it, but the OpenAI client requires one)
MODEL_API_KEY=
MODEL_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Second key/endpoint pair, used only by models that set
# use_alternate_provider = 2 in models.toml (or RESUMIX_<ROLE>_USE_ALTERNATE_PROVIDER=2
# below). Leave empty otherwise. A third provider works the same way:
# MODEL_API_KEY3 / MODEL_BASE_URL3 with use_alternate_provider = 3.
# MODEL_API_KEY2=
# MODEL_BASE_URL2=

# --- Per-model overrides -------------------------------------------------
# Override model name, temperature, thinking mode, reasoning effort, thinking
# budget, JSON output mode or provider for one role without editing
# models.toml — handy for Docker. Uncomment only what you need; anything
# unset keeps models.toml's value.
# Roles: DETECT, SUMMARY, CV, REVIEW, HIGHLIGHT. thinking is "auto" | "on" | "off".
# reasoning_effort is "low" | "medium" | "high". thinking_budget is a token
# count. structured_output is "json_schema_strict" | "json_schema" |
# "json_object" | "none". use_alternate_provider is 1 (MODEL_API_KEY /
# MODEL_BASE_URL) or N >= 2 (MODEL_API_KEY<N> / MODEL_BASE_URL<N>).
# THINKING_BUDGET, REASONING_EFFORT and TEMPERATURE set to empty (e.g.
# RESUMIX_REVIEW_THINKING_BUDGET=) unset the value instead of setting it to
# "" — the way to unset a thinking_budget that models.toml declares, since a
# declared budget always wins over reasoning_effort, and the way to send no
# temperature to an endpoint that rejects one (OpenAI's reasoning models).
# web_search is "true" | "false": false turns off the server-side web research
# for an endpoint that does not take DashScope's enable_search (e.g. OpenAI).
# RESUMIX_DETECT_MODEL=
# RESUMIX_DETECT_TEMPERATURE=
# RESUMIX_DETECT_THINKING=
# RESUMIX_DETECT_REASONING_EFFORT=
# RESUMIX_DETECT_THINKING_BUDGET=
# RESUMIX_DETECT_STRUCTURED_OUTPUT=  # leave at "none": the reply is plain text
# RESUMIX_DETECT_USE_ALTERNATE_PROVIDER=
# RESUMIX_SUMMARY_MODEL=
# RESUMIX_SUMMARY_TEMPERATURE=
# RESUMIX_SUMMARY_THINKING=
# RESUMIX_SUMMARY_REASONING_EFFORT=
# RESUMIX_SUMMARY_THINKING_BUDGET=
# RESUMIX_SUMMARY_STRUCTURED_OUTPUT=
# RESUMIX_SUMMARY_USE_ALTERNATE_PROVIDER=
# RESUMIX_SUMMARY_WEB_SEARCH=
# RESUMIX_CV_MODEL=
# RESUMIX_CV_TEMPERATURE=
# RESUMIX_CV_THINKING=
# RESUMIX_CV_REASONING_EFFORT=
# RESUMIX_CV_THINKING_BUDGET=
# RESUMIX_CV_STRUCTURED_OUTPUT=
# RESUMIX_CV_USE_ALTERNATE_PROVIDER=
# RESUMIX_REVIEW_MODEL=
# RESUMIX_REVIEW_TEMPERATURE=      # shipped at 0; the review loop relies on it
# RESUMIX_REVIEW_THINKING=
# RESUMIX_REVIEW_REASONING_EFFORT=
# RESUMIX_REVIEW_THINKING_BUDGET=
# RESUMIX_REVIEW_STRUCTURED_OUTPUT=  # leave at "none": the reply is plain text
# RESUMIX_REVIEW_USE_ALTERNATE_PROVIDER=
# RESUMIX_HIGHLIGHT_MODEL=
# RESUMIX_HIGHLIGHT_TEMPERATURE=
# RESUMIX_HIGHLIGHT_THINKING=
# RESUMIX_HIGHLIGHT_REASONING_EFFORT=
# RESUMIX_HIGHLIGHT_THINKING_BUDGET=
# RESUMIX_HIGHLIGHT_STRUCTURED_OUTPUT=
# RESUMIX_HIGHLIGHT_USE_ALTERNATE_PROVIDER=

# --- Server ------------------------------------------------------------------
# Require this bearer token on every /v1 call. Unset means the server is open
# to anyone who can reach it.
# RESUMIX_API_TOKEN=
# Requests in flight before the server answers 429 (default 10).
# RESUMIX_MAX_CONCURRENT_JOBS=10
# Wall clock for one CV run before it gives up (default 1200s).
# RESUMIX_REQUEST_BUDGET_SECONDS=1200
# Replacement prompts / template / models.toml (default: baked into the image).
# RESUMIX_RESOURCES=/path/to/resources
# Where per-request scratch directories are made (default: the system temp dir).
# RESUMIX_WORK_DIR=/tmp/resumix
# Port uvicorn listens on (default 8080; most platforms inject this).
# PORT=8080

# --- Client ------------------------------------------------------------------
# The client reads these too, but resumix.toml next to the binary is the
# usual way (see client/README.md).
# RESUMIX_API_URL=http://localhost:8080
